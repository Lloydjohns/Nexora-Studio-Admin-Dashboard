# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
#
# Both variables are NEXT_PUBLIC_, meaning they are sent to the browser.
# That is correct and safe for these two values: the publishable key is
# designed for public clients and carries no privileges of its own —
# Row Level Security decides what it can actually read or write.
#
# NEVER put the `service_role` / secret key in a NEXT_PUBLIC_ variable.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev