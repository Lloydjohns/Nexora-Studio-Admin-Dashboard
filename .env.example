# ============================================================
# SUPABASE
# ============================================================

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public/publishable Supabase key
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# SUPABASE SERVER / ADMIN
# ============================================================

# NEVER prefix this with NEXT_PUBLIC_
# NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ============================================================
# ADMIN ACCESS
# ============================================================

# Server-only list of administrator email addresses.
# Separate multiple emails with commas.
